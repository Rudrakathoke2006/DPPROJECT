<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Welcome · Campus & Co.</title><link rel="stylesheet" href="assets/app.css"><script src="assets/app.js" defer></script></head>
<body class="login-page"><main class="login-layout"><section class="login-story"><a class="brand light" href="app"><span class="brand-mark">c<span>✳</span></span> campus <i>&</i> co.</a><div class="story-copy"><span class="eyebrow">A LITTLE PLANNING. A LOT OF POSSIBILITY.</span><h1>Great moments<br>start on<br><em>campus.</em></h1><p>Bring your people, ideas, and events together.<br>One shared space for everything that happens next.</p></div><div class="story-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-ticket"><span>THE CAMPUS EXPERIENCE</span><strong>Make it<br>memorable.</strong><div>✳ &nbsp; IDEAS · PEOPLE · POSSIBILITIES</div></div><div class="art-sticker">GOOD<br>THINGS<br>AHEAD ↗</div></div><div class="story-footer">Your campus. More connected.<span>EST. 2026</span></div></section>
<section class="login-side"><div class="login-top">UNIVERSITY EVENT MANAGEMENT <span class="tiny-dot"></span></div><div class="login-form-wrap"><span class="eyebrow green">LET'S GET YOU IN</span><h2>Welcome back.</h2><p class="muted">Your next great campus experience starts here.</p>
<% if(session.getAttribute("flash")!=null) { %><div class="flash error" role="alert"><%=ViewData.h(session.getAttribute("flash"))%></div><%session.removeAttribute("flash");}%>
<form action="app" method="post" class="login-form"><input type="hidden" name="action" value="login"><input type="hidden" name="csrf" value="<%=ViewData.h(session.getAttribute("csrf"))%>"><label>Username<input name="username" autocomplete="username" placeholder="Enter your username" required autofocus></label><label>Password<span class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required><button type="button" class="reveal" data-password aria-label="Show password">Show</button></span></label><div class="login-hint"><span class="tiny-dot"></span> Sign in with your university project account</div><button class="button primary full" type="submit">Sign in to your workspace <span>↗</span></button></form><div class="account-note"><span class="note-icon">i</span><p>Student, faculty, or administrator?<br><strong>Your workspace adapts to your role.</strong></p></div></div><footer class="login-bottom">Made for campus life.<span>Campus & Co. © 2026</span></footer></section></main></body></html>
