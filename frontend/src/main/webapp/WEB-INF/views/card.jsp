<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,java.time.*,java.time.format.*,static campus.web.ViewData.*" %>
<% Map<String,String> c=(Map<String,String>)request.getAttribute("card");String type=c.get("eventType"),cls=type.toLowerCase();LocalDate day=date(c.get("date"));String symbol=type.equals("TECHNICAL")?"✳":type.equals("CULTURAL")?"✦":type.equals("SPORTS")?"◎":"▧"; %>
<article class="event-card" data-category="<%=h(type)%>" data-status="<%=h(c.get("status"))%>" data-search="<%=h(c.get("eventName")+" "+c.get("venue")+" "+c.get("eventId"))%>"><a class="card-art <%=h(cls)%>" href="app?page=event&id=<%=h(java.net.URLEncoder.encode(c.get("eventId"),java.nio.charset.StandardCharsets.UTF_8))%>" aria-label="View <%=h(c.get("eventName"))%>"><span class="art-category"><%=h(label(type))%></span><span class="card-symbol" aria-hidden="true"><%=symbol%></span><span class="card-art-word"><%=type.equals("TECHNICAL")?"Think beyond.":type.equals("CULTURAL")?"Feel the energy.":type.equals("SPORTS")?"Bring your game.":"Stay curious."%></span><span class="art-date"><strong><%=day.equals(LocalDate.MAX)?"—":day.getDayOfMonth()%></strong><%=day.equals(LocalDate.MAX)?"TBA":day.format(DateTimeFormatter.ofPattern("MMM",Locale.ENGLISH)).toUpperCase()%></span></a><div class="card-content"><div class="card-meta"><span class="badge <%=h(c.get("status").toLowerCase())%>"><span class="tiny-dot"></span><%=h(label(c.get("status")))%></span><span><%=h(label(c.get("eventLevel")))%></span></div><h3><a href="app?page=event&id=<%=h(java.net.URLEncoder.encode(c.get("eventId"),java.nio.charset.StandardCharsets.UTF_8))%>"><%=h(c.get("eventName"))%></a></h3><p class="card-location">⌖ &nbsp;<%=h(c.get("venue"))%></p><div class="card-bottom"><span><%=h(prettyDate(c.get("date")))%></span><a href="app?page=event&id=<%=h(java.net.URLEncoder.encode(c.get("eventId"),java.nio.charset.StandardCharsets.UTF_8))%>" aria-label="View <%=h(c.get("eventName"))%>">↗</a></div></div></article>
