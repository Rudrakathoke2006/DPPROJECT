<div class="page-heading"><div><div class="eyebrow">BETTER WHEN WE'RE TOGETHER</div><h1><%=student?"You're on the list":"The guest list"%><span class="green">.</span></h1><p><%=student?"Your campus plans, all in one place.":"Every sign-up is the beginning of a great experience."%></p></div><a class="button primary" href="app?page=events">Explore events ↗</a></div><div class="panel table-panel"><table><thead><tr><th>Registration</th><th>Event</th><%if(!student){%><th>Student</th><%}%><th>Notifications</th><th>Status</th></tr></thead><tbody><%for(Map<String,String> r:registrations){%><tr><td class="mono"><%=h(r.get("registrationId"))%></td><td><a class="table-name" href="app?page=event&id=<%=h(r.get("eventId"))%>"><%=h(r.get("eventName"))%> ↗</a><small><%=h(r.get("eventId"))%></small></td><%if(!student){%><td><%=h(r.get("studentUsername"))%></td><%}%><td><%=h(r.get("notificationChannel"))%></td><td><span class="badge approved">Confirmed</span></td></tr><%}%></tbody></table><%if(registrations.isEmpty()){%><div class="empty-state">No registrations yet. Your next experience is waiting.</div><%}%></div>
<%}else if(current.equals("resources")){%>
<div class="page-heading"><div><div class="eyebrow">THE DETAILS THAT MAKE IT HAPPEN</div><h1>Room for possibility<span class="green">.</span></h1><p>Spaces, equipment, and the people behind every great event.</p></div></div><%if(manager){%><jsp:include page="resource-picker.jsp"/><%}%><div class="section-heading"><h2>Campus spaces</h2><span class="muted"><%=venues.size()%> venues in the directory</span></div><div class="venue-grid"><%for(Map<String,String> v:venues){%><article class="venue-card"><span class="venue-glyph">◇</span><span class="eyebrow"><%=h(v.get("venueId"))%></span><h2><%=h(v.get("name"))%></h2><p><%=h(v.get("equipment").replace(";"," · "))%></p><div><span>♧ <%=h(v.get("capacity"))%> people</span><strong>₹ <%=h(v.get("cost"))%></strong></div><%if(manager){%><button type="button" class="button secondary full choose-venue" data-venue="<%=h(v.get("venueId"))%>">Choose this venue ↗</button><%}%></article><%}%></div><div class="section-heading"><h2>Current allocations</h2><span class="muted">Allocate from an approved event's details</span></div><div class="panel table-panel"><table><thead><tr><th>Event</th><th>Venue</th><th>Equipment</th><th>Support team</th></tr></thead><tbody><%for(Map<String,String> r:resources){%><tr><td><a class="table-name" href="app?page=event&id=<%=h(r.get("eventId"))%>"><%=h(r.get("eventName"))%> ↗</a></td><td><%=h(r.get("venue"))%></td><td><%=h(r.get("equipment"))%></td><td><%=h(r.get("supportStaff"))%></td></tr><%}%></tbody></table><%if(resources.isEmpty()){%><div class="empty-state">No resources allocated yet.</div><%}%></div>
<%}else if(current.equals("notifications")){%>
<div class="page-heading"><div><div class="eyebrow">A NOTE FROM YOUR CAMPUS</div><h1>In the loop<span class="green">.</span></h1><p>Your registration confirmations and event updates, together.</p></div><span class="step-pill"><%=notifications.size()%> UPDATES</span></div><div class="panel notifications"><%for(int i=notifications.size()-1;i>=0;i--){Map<String,String> n=notifications.get(i);%><article class="notification-row"><span class="notification-circle">↗</span><div><span class="eyebrow"><%=h(n.get("channel"))%> · <%=h(n.get("eventId"))%></span><h2><%=h(n.get("eventName"))%></h2><p><%=h(n.get("message"))%></p></div><a class="text-link" href="app?page=event&id=<%=h(n.get("eventId"))%>" aria-label="View event">↗</a></article><%}if(notifications.isEmpty()){%><div class="empty-state"><h2>A little quiet, for now.</h2><p>Your event updates will land here.</p></div><%}%></div>
<%}else if(current.equals("activity")){%><div class="page-heading"><div><div class="eyebrow">EVERY STEP TELLS A STORY</div><h1>Campus in motion<span class="green">.</span></h1><p>A shared timeline of the work that brings events to life.</p></div></div><div class="panel activity-panel"><%for(int i=activity.size()-1;i>=0;i--){Map<String,String> a=activity.get(i);%><article class="activity-row"><span class="activity-dot"></span><div><span class="eyebrow"><%=h(a.get("timestamp"))%></span><h3><%=h(label(a.get("outcome")))%> <span>· <%=h(a.get("eventId"))%></span></h3><p><%=h(a.get("detail"))%></p></div><a class="text-link" href="app?page=event&id=<%=h(a.get("eventId"))%>">View event ↗</a></article><%}if(activity.isEmpty()){%><div class="empty-state">Your campus story starts with the first event.</div><%}%></div><%}%>
<footer class="page-footer"><span>campus <i>&</i> co.</span><p>Made for the moments that bring us together.</p><span>UNIVERSITY WORKSPACE &nbsp; ✳</span></footer></main></div></div></body></html>
