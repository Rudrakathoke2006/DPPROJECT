<%List<Map<String,String>> upcoming=new ArrayList<>(); for(Map<String,String> e:events)if(!date(e.get("date")).isBefore(LocalDate.now())&&!"REJECTED".equals(e.get("status")))upcoming.add(e); for(Map<String,String> e:upcoming.subList(0,Math.min(2,upcoming.size()))){request.setAttribute("card",e);%><jsp:include page="card.jsp"/><%}if(upcoming.isEmpty()){%><div class="empty-state">No upcoming events yet. A little inspiration goes a long way.</div><%}%></div></section><aside><div class="section-heading"><div><span class="eyebrow">KEEP THINGS MOVING</span><h2><%=student?"Your next chapter":"Your to-do, simplified"%></h2></div><span>↗</span></div><div class="todo-card"><div class="todo-number"><%=student?registrations.size():waiting.size()%><span><%=student?"events on your list":"requests to review"%></span></div><p><%=student?"Good company. New ideas. Something to look forward to.":"A quick review today makes tomorrow's campus moments possible."%></p><a class="button secondary full" href="app?page=<%=student?"registrations":"approvals"%>"><%=student?"My registrations":"Review approvals"%> <span>→</span></a></div><div class="little-note"><span>✳</span><p>A little coordination.<br><strong>A lot of possibility.</strong></p></div></aside></div>
<%} else if(current.equals("events")){%>
