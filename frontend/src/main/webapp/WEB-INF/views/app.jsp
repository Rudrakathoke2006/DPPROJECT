<%} else if(Set.of("create","edit","clone").contains(current)){ Map<String,String> e=selected==null?new HashMap<>():selected, d=find(details,"eventId",e.getOrDefault("eventId","")); boolean creating=current.equals("create"), cloning=current.equals("clone");%>
<a class="back-link" href="app?page=events">← Back to events</a><div class="page-heading"><div><div class="eyebrow">GIVE YOUR IDEA A PLACE TO BEGIN</div><h1><%=creating?"Make something happen":cloning?"A fresh take":"Refine the details"%><span class="green">.</span></h1><p><%=cloning?"Keep the inspiration. Start a new event with a fresh approval request.":"Fill in the details. We'll take it from there."%></p></div><span class="step-pill">01 &nbsp; / &nbsp; EVENT DETAILS</span></div>
<div class="form-layout"><form class="panel event-form" action="app" method="post"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="<%=current%>"><%if(!creating){%><input type="hidden" name="id" value="<%=h(e.get("eventId"))%>"><%}%><div class="form-section-title"><span>01</span><div><h2>The essentials</h2><p>Every great event starts with the basics.</p></div></div><div class="form-fields"><%if(creating||cloning){%><label>Event ID<input name="<%=cloning?"newId":"id"%>" placeholder="e.g. EVT105" pattern="[A-Za-z0-9_-]{1,40}" maxlength="40" required></label><%}%><label class="<%=creating||cloning?"":"wide"%>">Event name<input name="name" value="<%=h(e.getOrDefault("eventName","")+(cloning?" (Copy)":""))%>" placeholder="Give your event a memorable name" maxlength="180" required></label><%if(creating){%><label>Event category<select name="type" required><option value="1">Technical</option><option value="2">Cultural</option><option value="3">Sports</option><option value="4">Workshop</option></select></label><label>Event level<select name="level"><option value="DEPARTMENT">Department</option><option value="INTER_DEPARTMENT">Inter-department</option><option value="UNIVERSITY">University</option></select></label><%}%><label>Event date<input type="date" name="date" value="<%=cloning?"":isoDate(e.get("date"))%>" required></label><label>Proposed venue<input name="venue" list="venue-options" value="<%=h(e.get("venue"))%>" placeholder="Where will it happen?" required><datalist id="venue-options"><%for(Map<String,String> v:venues){%><option value="<%=h(v.get("name"))%>"><%}%></datalist></label></div>
<%if(!cloning){%><div class="form-section-title"><span>02</span><div><h2>Make it yours</h2><p>A few thoughtful details make all the difference.</p></div></div><div class="form-fields"><label class="wide">Description<input name="description" value="<%=h(d.get("description"))%>" placeholder="What's the big idea?" maxlength="1500"></label><label>Budget (₹)<input type="number" min="0" step="0.01" name="budget" value="<%=h(d.getOrDefault("budget","0"))%>" required></label><label>Expected attendees<input type="number" min="0" name="capacity" value="<%=h(d.getOrDefault("capacity","0"))%>" required></label><label>Duration (hours)<input type="number" min="0" name="duration" value="<%=h(d.getOrDefault("durationHours","0"))%>" required></label><label>Equipment needs<input name="equipment" value="<%=h(d.get("equipment"))%>" placeholder="Projector; WiFi; Sound system"></label><label class="wide">Special instructions<input name="instructions" value="<%=h(d.get("specialInstructions"))%>" placeholder="Anything participants should know?"></label></div><%}%><div class="form-actions"><a class="button secondary" href="app?page=events">Cancel</a><button class="button primary" type="submit"><%=creating?"Create & submit for approval":cloning?"Duplicate & submit":"Save changes"%> ↗</button></div></form><aside><div class="form-note"><span class="large-star">✳</span><h2>A good plan.<br>A great beginning.</h2><p>Your event begins as pending and follows your university's approval process.</p><ol><li><strong>Faculty review</strong><span>Every event starts here.</span></li><li><strong>HOD review</strong><span>For inter-department and university events.</span></li><li><strong>Dean review</strong><span>Final review for university events.</span></li></ol></div><p class="form-disclaimer">Venue and resource allocation happens after approval. Editing an event requires a new approval.</p></aside></div>
<%} else if(current.equals("event")){Map<String,String> e=selected,d=find(details,"eventId",e.get("eventId")), allocation=find(resources,"eventId",e.get("eventId"));String id=e.get("eventId");boolean isApproved="APPROVED".equals(e.get("status")), registered=!find(registrations,"eventId",id).isEmpty();%>
<a class="back-link" href="app?page=events">← Back to events</a><div class="event-detail-hero <%=h(e.get("eventType").toLowerCase())%>"><div><span class="eyebrow"><%=h(label(e.get("eventType")))%> / <%=h(id)%></span><h1><%=h(e.get("eventName"))%></h1><p><%=h(label(e.get("eventLevel")))%> event · Organized by <%=h(e.get("organizer"))%></p><span class="badge <%=h(e.get("status").toLowerCase())%>"><%=h(label(e.get("status")))%></span></div><span class="detail-symbol" aria-hidden="true"><%=e.get("eventType").equals("TECHNICAL")?"✳":e.get("eventType").equals("SPORTS")?"◎":"✦"%></span></div>
<div class="detail-grid"><section><div class="panel"><span class="eyebrow">THE BIG IDEA</span><h2>About this event</h2><p class="description"><%=h(d.getOrDefault("description","Details are coming together. Check back for more information."))%></p><div class="detail-facts"><div><small>DATE</small><strong><%=h(prettyDate(e.get("date")))%></strong></div><div><small>PROPOSED VENUE</small><strong><%=h(e.get("venue"))%></strong></div><div><small>EXPECTED ATTENDEES</small><strong><%=h(d.getOrDefault("capacity","Not specified"))%></strong></div><div><small>DURATION</small><strong><%=h(d.getOrDefault("durationHours","—"))%> hours</strong></div><div><small>BUDGET</small><strong>₹ <%=h(d.getOrDefault("budget","0"))%></strong></div><div><small>EQUIPMENT</small><strong><%=h(d.getOrDefault("equipment","Not specified"))%></strong></div></div><div class="instruction-note"><strong>A little heads-up</strong><p><%=h(d.getOrDefault("specialInstructions","No special instructions yet."))%></p></div></div>
<div class="panel"><div class="section-heading"><h2>Behind the scenes</h2><span class="eyebrow">RESOURCES</span></div><%if(allocation.isEmpty()){%><p class="muted">Resources haven't been allocated yet.</p><%}else{%><div class="resource-list"><div><span>◇</span><p>Allocated venue<strong><%=h(allocation.get("venue"))%></strong></p></div><div><span>▦</span><p>Equipment<strong><%=h(allocation.get("equipment"))%></strong></p></div><div><span>♧</span><p>Support team<strong><%=h(allocation.get("supportStaff"))%></strong></p></div></div><%}%></div></section><aside><div class="panel action-panel"><h2><%=student?"Be part of it":"Keep it moving"%></h2><%if(student){ if(registered){%><div class="registered-banner">✓ You're on the list.</div><p>Notification channel: <strong><%=h(find(registrations,"eventId",id).get("notificationChannel"))%></strong></p><a class="button secondary full" href="app?page=registrations">View my registrations</a><%}else{%><p>Good experiences are better together. Save your place.</p><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=h(id)%>"><input type="hidden" name="action" value="register"><fieldset class="channel-picker"><legend>How should we notify you?</legend><p>Choose a channel before confirming your registration.</p><label><input type="radio" name="channel" value="INAPP" required> In-app notifications</label><label><input type="radio" name="channel" value="EMAIL" required> Email</label><label><input type="radio" name="channel" value="SMS" required> SMS</label></fieldset><button class="button primary full">Register for event ↗</button></form><%}}else{if(manager){ if(allocation.isEmpty()){%><a class="button secondary full" href="app?page=edit&id=<%=h(id)%>">Edit event details ↗</a><form method="post" action="app" data-confirm="Restore the last edit? This will restart faculty approval."><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="undo"><input type="hidden" name="id" value="<%=h(id)%>"><button class="button secondary full">↶ Undo last edit</button></form><%}if(isApproved&&allocation.isEmpty()){%><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="allocate"><input type="hidden" name="id" value="<%=h(id)%>"><button class="button primary full">Allocate resources ↗</button></form><%} }if(faculty){%><a class="button secondary full" href="app?page=clone&id=<%=h(id)%>">Duplicate this event ↗</a><form method="post" action="app"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="prepare"><input type="hidden" name="id" value="<%=h(id)%>"><button class="button secondary full">Check event readiness</button></form><%}if(!isApproved){%><p class="muted">This event needs approval before registration and resource allocation can begin.</p><%}}%></div>
<%if(!student&&isApproved){%><form method="post" action="app" class="panel"><h2>Keep everyone in the loop</h2><p class="muted">Send an update to registered students.</p><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="publish"><input type="hidden" name="id" value="<%=h(id)%>"><label>Event update<input name="message" placeholder="What's new?" maxlength="1500" required></label><button class="button primary full">Publish update ↗</button></form><%}%></aside></div><%if(session.getAttribute("report")!=null){%><div class="panel"><h2>Preparation report</h2><pre class="report"><%=h(session.getAttribute("report"))%></pre></div><%session.removeAttribute("report");}%>
