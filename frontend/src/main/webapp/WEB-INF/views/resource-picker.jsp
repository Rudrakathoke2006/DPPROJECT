<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,static campus.web.ViewData.*" %>
<% List<Map<String,String>> allEvents=(List<Map<String,String>>)request.getAttribute("events"), allResources=(List<Map<String,String>>)request.getAttribute("resources"), allVenues=(List<Map<String,String>>)request.getAttribute("venues"); List<Map<String,String>> eligible=new ArrayList<>();for(Map<String,String> e:allEvents)if("APPROVED".equals(e.get("status"))&&find(allResources,"eventId",e.get("eventId")).isEmpty())eligible.add(e); %>
<section class="panel" id="allocation-panel"><h2>Allocate a venue & resources</h2><%if(eligible.isEmpty()){%><p class="muted">No approved events are waiting for allocation. Existing allocations appear below. Approve a pending event first to allocate its resources.</p><a class="button secondary" href="app?page=events">View events ↗</a><%}else{%><p class="muted">Choose a venue card below, then select an event and confirm its requirements. Equipment and support staff follow the event category.</p><form action="app" method="post" id="allocation-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("csrf"))%>"><input type="hidden" name="action" value="allocateVenue"><div class="form-fields"><label>Approved event<select name="id" required><option value="">Choose an event</option><%for(Map<String,String> e:eligible){%><option value="<%=h(e.get("eventId"))%>"><%=h(e.get("eventName"))%> · <%=h(prettyDate(e.get("date")))%></option><%}%></select></label><label>Selected venue<select name="venueId" id="selected-venue" required><option value="">Choose a venue</option><%for(Map<String,String> v:allVenues){%><option value="<%=h(v.get("venueId"))%>"><%=h(v.get("name"))%></option><%}%></select></label><label>Expected attendees<input type="number" name="attendees" min="1" required placeholder="e.g. 100"></label><label>Maximum venue budget (₹)<input type="number" name="budget" min="0" step="0.01" required placeholder="e.g. 15000"></label><label class="wide">Required venue equipment<input name="equipment" placeholder="e.g. projector;wifi (optional)"></label></div><button class="button primary">Confirm venue & allocate resources ↗</button></form><%}%></section>
